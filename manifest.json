{
  "manifest_version": 3,
  "name": "Akıllı YouTube Çevirisi",
  "version": "0.1.3",
  "description": "YouTube altyazılarını kendi AI hesabınızla (Gemini, Groq, OpenRouter, Ollama...) canlı ve yüksek kalitede çevirir.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.cerebras.ai/*",
    "https://api.mistral.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "src/content/common.js",
        "src/content/transcript.js",
        "src/content/transcript-panel.js",
        "src/content/dom-captions.js",
        "src/content/overlay.js",
        "src/content/engine.js",
        "src/content/main.js"
      ],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Akıllı YouTube Çevirisi"
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Çeviri katmanını aç/kapat"
    }
  }
}
